#include <stdio.h>
#include <string.h>

int isVowel(char ch)
{
    if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u'||
       ch=='A'||ch=='E'||ch=='I'||ch=='O'||ch=='U')
        return 1;
    return 0;
}

int main()
{
    char str[200];
    int i, count = 0;

    printf("Enter a line: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(isVowel(str[i]) && isVowel(str[i+1]))
            count++;
    }

    printf("Number of consecutive vowels = %d", count);

    return 0;
}